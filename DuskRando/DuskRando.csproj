<Project Sdk="Microsoft.NET.Sdk">
  <!--
    BepInEx 5 plugin for DUSK (Unity 2018.2.8f1, Mono, .NET 4.x profile).
    Build:  dotnet build -c Release            (or set DuskDir if the game lives elsewhere)
    Output: bin/Release/net46/ plus dist/DuskRando-v<Version>.zip (see PackageReleaseZip below)
  -->
  <PropertyGroup>
    <TargetFramework>net46</TargetFramework>
    <AssemblyName>DuskRando</AssemblyName>
    <RootNamespace>DuskRando</RootNamespace>
    <Version>0.4.3</Version>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DuskDir Condition="'$(DuskDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Dusk</DuskDir>
    <DuskManaged>$(DuskDir)\Dusk_Data\Managed</DuskManaged>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" PrivateAssets="all" />
    <!-- Pinned: CompressedSocket.cs builds the session from this exact version's internal helper constructors. -->
    <PackageReference Include="Archipelago.MultiClient.Net" Version="[6.7.1]" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(DuskManaged)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ES2"><HintPath>$(DuskManaged)\ES2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(DuskManaged)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(DuskManaged)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(DuskManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(DuskManaged)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(DuskManaged)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(DuskManaged)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(DuskManaged)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(DuskManaged)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(DuskManaged)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <!-- TextAnchor, FontStyle (GUIStyle alignment) -->
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(DuskManaged)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputModule"><HintPath>$(DuskManaged)\UnityEngine.InputModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Single source of truth for location IDs, shared with the APWorld. -->
    <EmbeddedResource Include="..\apworld\dusk\data\locations.json" LogicalName="DuskRando.locations.json" />
    <!-- AP item sprites (derived from Archipelago's MIT-licensed data/icon.png) -->
    <EmbeddedResource Include="Assets\*.png" LogicalName="DuskRando.Assets.%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    PluginInfo.Version: <Version> above is the only place the version is written. This generates a constant from
    it for the BepInPlugin attribute and the version shown in the connection window (issue #29).
  -->
  <Target Name="GeneratePluginInfo" BeforeTargets="BeforeCompile;CoreCompile">
    <PropertyGroup>
      <PluginInfoFile>$(IntermediateOutputPath)PluginInfo.g.cs</PluginInfoFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(PluginInfoFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="namespace DuskRando { internal static class PluginInfo { public const string Version = &quot;$(Version)&quot;%3B } }" />
    <ItemGroup>
      <Compile Include="$(PluginInfoFile)" />
      <FileWrites Include="$(PluginInfoFile)" />
    </ItemGroup>
  </Target>

  <!--
    Release builds also produce dist/DuskRando-v<Version>.zip for the GitHub Releases page.
    The zip mirrors the game folder (BepInEx/plugins/DuskRando/...), so players extract it straight
    into the folder that contains Dusk.exe.
  -->
  <Target Name="PackageReleaseZip" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ReleaseStaging>$(BaseIntermediateOutputPath)release-zip\</ReleaseStaging>
      <ReleaseZip>$(MSBuildProjectDirectory)\..\dist\DuskRando-v$(Version).zip</ReleaseZip>
    </PropertyGroup>
    <ItemGroup>
      <ReleaseDll Include="$(OutDir)DuskRando.dll;$(OutDir)Archipelago.MultiClient.Net.dll;$(OutDir)Newtonsoft.Json.dll" />
    </ItemGroup>
    <Error Condition="!Exists('%(ReleaseDll.Identity)')" Text="Release zip: missing %(ReleaseDll.Identity)" />
    <RemoveDir Directories="$(ReleaseStaging)" />
    <Copy SourceFiles="@(ReleaseDll)" DestinationFolder="$(ReleaseStaging)BepInEx\plugins\DuskRando" />
    <MakeDir Directories="$(MSBuildProjectDirectory)\..\dist" />
    <ZipDirectory SourceDirectory="$(ReleaseStaging)" DestinationFile="$(ReleaseZip)" Overwrite="true" />
    <Message Importance="high" Text="Release zip: $(ReleaseZip)" />
  </Target>
</Project>
